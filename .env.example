APP_NAME=titulacion-rag-api
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173
# LLM: Google Gemini is the primary provider; OpenAI is used only as fallback.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
AI_API_KEY=
GEMINI_API_KEY=
FALLBACK_PROVIDER=openai
FALLBACK_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=15
LLM_RETRIES=0
LLM_MAX_INPUT_CHARS=2000
EMBEDDING_MODEL=
CHROMA_PERSIST_DIR=./data/chroma
RAG_REQUIRE_VERIFIED_SOURCES=true
