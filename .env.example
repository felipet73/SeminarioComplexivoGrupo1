APP_NAME=titulacion-rag-api
APP_ENV=development
APP_REVISION=unknown
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173
# Producción Cloud Run (sin barra final):
# CORS_ORIGINS=https://seminario-complexivo-grupo1.vercel.app
# LLM: Google Gemini is the primary provider; OpenAI is used only as fallback.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
AI_API_KEY=
GEMINI_API_KEY=
FALLBACK_PROVIDER=openai
FALLBACK_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=15
LLM_RETRIES=0
LLM_MAX_INPUT_CHARS=2000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_COOKIE_SECURE=false
# Producción HTTPS: ADMIN_COOKIE_SECURE=true y APP_ENV=production.
ADMIN_SESSION_MINUTES=60
# Variable del proceso/contenedor: directorio SQLite y originales. Vacío usa data/admin.
RAG_DATA_DIR=

# Optativo, variable del proceso/Secret Manager: DSN PostgreSQL. Vacio conserva SQLite.
# En Cloud Run usar socket Cloud SQL; nunca versionar un DSN con credenciales.
RAG_DATABASE_URL=
