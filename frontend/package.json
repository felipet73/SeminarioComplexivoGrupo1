{
  "name": "uniandes-titulacion-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tipos": "openapi-typescript http://127.0.0.1:8000/openapi.json -o src/api.generated.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:admin": "playwright test --config playwright.admin.config.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^28.0.0",
    "msw": "^2.12.0",
    "openapi-typescript": "^7.12.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
